# Generated by packaging/homebrew/make-homebrew.sh for each release.
cask "capycal-app" do
  version "@VERSION@"
  sha256 "@SHA256_DMG@"

  url "https://github.com/twiebe/capycal/releases/download/v#{version}/capycal-v#{version}-macos.dmg"
  name "Capycal"
  desc "Menu bar app that syncs calendars and knows how to keep a secret"
  homepage "https://capycal.app"

  depends_on arch: :arm64
  depends_on macos: ">= :sonoma"

  # The bundled CLI is not linked, so the cask and the capycal formula can be
  # installed side by side
  app "Capycal.app"

  uninstall quit:      "app.capycal",
            launchctl: "app.capycal-ui"

  zap trash: [
    "~/Library/Application Support/capycal",
    "~/Library/LaunchAgents/app.capycal-ui.plist",
    "~/Library/Preferences/app.capycal.plist",
  ]

  caveats <<~EOS
    Capycal.app is not notarized, so macOS refuses its first start. Right-click
    it in Finder and choose Open, or remove the quarantine flag once:
      xattr -dr com.apple.quarantine #{appdir}/Capycal.app
  EOS
end
