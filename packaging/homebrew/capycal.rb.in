# Generated by packaging/homebrew/make-homebrew.sh for each release.
class Capycal < Formula
  desc "Calendar sync that knows how to keep a secret"
  homepage "https://capycal.app"
  version "@VERSION@"
  license "GPL-3.0-only"

  on_macos do
    depends_on arch: :arm64
    url "https://github.com/twiebe/capycal/releases/download/v#{version}/capycal-v#{version}-aarch64-apple-darwin.tar.gz"
    sha256 "@SHA256_MACOS@"
  end

  on_linux do
    on_intel do
      url "https://github.com/twiebe/capycal/releases/download/v#{version}/capycal-v#{version}-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA256_X86_64@"
    end
    on_arm do
      url "https://github.com/twiebe/capycal/releases/download/v#{version}/capycal-v#{version}-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA256_AARCH64@"
    end
  end

  def install
    bin.install "capycal"
    generate_completions_from_executable(bin/"capycal", "--completions")
    (man1/"capycal.1").write Utils.safe_popen_read(bin/"capycal", "--man")
    pkgshare.install "capycal.example.toml"
    prefix.install "CONTRIBUTORS.md", "THIRD-PARTY-NOTICES.txt"
  end

  def caveats
    <<~EOS
      Create a config with:
        capycal --generate-config
      An example with every option is in:
        #{opt_pkgshare}/capycal.example.toml
    EOS
  end

  # Runs the default config, like `capycal --install-service`
  service do
    run opt_bin/"capycal"
    keep_alive true
    log_path var/"log/capycal.log"
    error_log_path var/"log/capycal.log"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/capycal --version")
  end
end
