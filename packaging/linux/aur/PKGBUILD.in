# Maintainer: Thomas Wiebe
# Generated by packaging/linux/aur/make-pkgbuild.sh for each release.
pkgname=capycal-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Calendar sync that knows how to keep a secret"
arch=('x86_64' 'aarch64')
url="https://github.com/twiebe/capycal"
license=('GPL-3.0-only')
provides=('capycal')
conflicts=('capycal')
source_x86_64=("https://github.com/twiebe/capycal/releases/download/v${pkgver}/capycal-v${pkgver}-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("https://github.com/twiebe/capycal/releases/download/v${pkgver}/capycal-v${pkgver}-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('@SHA256_X86_64@')
sha256sums_aarch64=('@SHA256_AARCH64@')

package() {
    cd "capycal-v${pkgver}-${CARCH}-unknown-linux-musl"
    install -Dm755 capycal "$pkgdir/usr/bin/capycal"
    install -Dm644 capycal.1 "$pkgdir/usr/share/man/man1/capycal.1"
    install -Dm644 completions/capycal.bash "$pkgdir/usr/share/bash-completion/completions/capycal"
    install -Dm644 completions/_capycal "$pkgdir/usr/share/zsh/site-functions/_capycal"
    install -Dm644 completions/capycal.fish "$pkgdir/usr/share/fish/vendor_completions.d/capycal.fish"
    sed 's|/usr/local/bin/capycal|/usr/bin/capycal|' systemd/capycal.service \
        | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/capycal.service"
    sed 's|/usr/local/bin/capycal|/usr/bin/capycal|' systemd/capycal-user.service \
        | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/capycal.service"
    install -Dm644 capycal.example.toml "$pkgdir/usr/share/doc/capycal/capycal.example.toml"
    install -Dm644 README.md "$pkgdir/usr/share/doc/capycal/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/capycal/LICENSE"
    install -Dm644 CONTRIBUTORS.md "$pkgdir/usr/share/licenses/capycal/CONTRIBUTORS.md"
    install -Dm644 THIRD-PARTY-NOTICES.txt "$pkgdir/usr/share/licenses/capycal/THIRD-PARTY-NOTICES.txt"
}
