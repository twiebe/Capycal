# Maintainer: Thomas Wiebe
# Generated by packaging/linux/aur/make-pkgbuild.sh for each release.
pkgname=capycal-app-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Calendar sync that knows how to keep a secret (desktop app)"
arch=('x86_64' 'aarch64')
url="https://github.com/twiebe/capycal"
license=('GPL-3.0-only')
depends=('glibc' 'gtk4>=4.14' 'libadwaita>=1.5')
optdepends=('gnome-shell-extension-appindicator: tray icon on GNOME')
provides=('capycal-app')
conflicts=('capycal-app')
options=('!debug')
source_x86_64=("https://github.com/twiebe/capycal/releases/download/v${pkgver}/capycal-app_${pkgver}-1_amd64.deb")
source_aarch64=("https://github.com/twiebe/capycal/releases/download/v${pkgver}/capycal-app_${pkgver}-1_arm64.deb")
sha256sums_x86_64=('@SHA256_X86_64@')
sha256sums_aarch64=('@SHA256_AARCH64@')

package() {
    bsdtar -xf data.tar.* -C "$pkgdir"
    install -Dm644 "$pkgdir/usr/share/doc/capycal-app/copyright" "$pkgdir/usr/share/licenses/capycal-app/LICENSE"
}
